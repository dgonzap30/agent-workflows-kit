# SSH config — redacted public copy
# Real config lives at ~/.ssh/config; secrets stripped from this version.
# Replace <REDACTED-*> placeholders before use on a new machine.

Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Internal headless host (Tailscale)
Host <REDACTED-INTERNAL-ALIAS>
  HostName <REDACTED-TAILSCALE-IP>
  User <REDACTED-USER>
  IdentityFile ~/.ssh/id_ed25519_mini
  AddKeysToAgent yes
  UseKeychain yes

  # Primary workstation on the tailnet. Set User to your own account.
# When Tailscale SSH is enabled server-side, identity comes from the tailnet —
# no key needed. If not, copy a key over with:
#   ssh-copy-id -i ~/.ssh/id_ed25519_mini <alias>
Host <REDACTED-INTERNAL-ALIAS-1> <REDACTED-INTERNAL-ALIAS-2>
  HostName <REDACTED-MAGICDNS-NAME>
  User <REDACTED-USER>
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519_mini
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

# IP fallback if MagicDNS is flaky
Host <REDACTED-INTERNAL-ALIAS-FALLBACK>
  HostName <REDACTED-TAILSCALE-IP>
  User <REDACTED-USER>
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519_mini
